{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS server application",
  "scripts": {
    "build:weapp": "NODE_OPTIONS='--max-old-space-size=4096' taro build --type weapp",
    "build:tt": "NODE_OPTIONS='--max-old-space-size=4096' taro build --type tt",
    "build": "nest build",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:h5\"",
    "dev:server": "nest start --watch",
    "dev:h5": "NODE_OPTIONS='--max-old-space-size=4096' taro build --type h5 --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/lib-storage": "^3.958.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^6.1.3",
    "@supabase/supabase-js": "2.95.3",
    "axios": "^1.17.0",
    "coze-coding-dev-sdk": "^0.7.16",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "express": "5.2.1",
    "pg": "^8.16.3",
    "rxjs": "^7.8.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@tailwindcss/postcss": "^4.3.0",
    "@tarojs/cli": "^4.2.0",
    "@tarojs/components": "^4.2.0",
    "@tarojs/plugin-framework-react": "^4.2.0",
    "@tarojs/plugin-generator": "^4.2.0",
    "@tarojs/plugin-platform-h5": "^4.2.0",
    "@tarojs/plugin-platform-weapp": "^4.2.0",
    "@tarojs/react": "^4.2.0",
    "@tarojs/runtime": "^4.2.0",
    "@tarojs/vite-runner": "^4.2.0",
    "@tarojs/webpack5-runner": "^4.2.0",
    "@types/express": "5.0.6",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.8",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "weapp-tailwindcss": "^4.12.0"
  }
}
